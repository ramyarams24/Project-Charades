# Copy this file to ".env" and fill in the values.

# Anthropic API key — get one from https://console.anthropic.com/ (Settings -> API Keys).
ANTHROPIC_API_KEY=sk-ant-your-key-here

# MongoDB connection string for user accounts (login/signup).
# Get a free one from MongoDB Atlas: https://www.mongodb.com/cloud/atlas
# Looks like: mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/charades?retryWrites=true&w=majority
MONGODB_URI=

# Secret used to sign login tokens. Use any long random string.
JWT_SECRET=change-me-to-a-long-random-string

# Email sending for password-reset links (optional).
# If RESEND_API_KEY is left blank, reset links are printed to the server console
# instead of emailed — handy for local testing with no setup.
# Get a free key from https://resend.com (Settings -> API Keys).
RESEND_API_KEY=
# Sender shown on the email. On Resend's free tier (no custom domain) keep this
# as their shared sender; once you verify a domain you can use your own address.
EMAIL_FROM=Charades Night <onboarding@resend.dev>
